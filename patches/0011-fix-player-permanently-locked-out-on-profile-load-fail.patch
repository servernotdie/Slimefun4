From c07c2275b96c726409491007042091813a356cec Mon Sep 17 00:00:00 2001
From: mytai20100 <142713298+Mytai20100@users.noreply.github.com>
Date: Sat, 1 Aug 2026 14:47:38 +0700
Subject: [PATCH] fix: player permanently locked out when profile load fails or
 hangs

- PlayerProfile.getOrCreate: processProfiles.remove now always runs (finally),
  added 10s timeout for profile loading and fallback to a temporary profile
  instead of permanently locking the player (guide shows 'opening' but never opens)
- ProfileDataController.getProfileAsync: wrapped in try/catch, DB read errors
  are logged at SEVERE and the callback receives null instead of failing silently
---
 .../controller/ProfileDataController.java     |  13 ++-
 .../slimefun4/api/player/PlayerProfile.java   | 100 +++++++++++++-----
 2 files changed, 84 insertions(+), 29 deletions(-)

diff --git a/src/main/java/com/xzavier0722/mc/plugin/slimefun4/storage/controller/ProfileDataController.java b/src/main/java/com/xzavier0722/mc/plugin/slimefun4/storage/controller/ProfileDataController.java
index 35889674c..6cd766d35 100644
--- a/src/main/java/com/xzavier0722/mc/plugin/slimefun4/storage/controller/ProfileDataController.java
+++ b/src/main/java/com/xzavier0722/mc/plugin/slimefun4/storage/controller/ProfileDataController.java
@@ -113,7 +113,18 @@ public class ProfileDataController extends ADataController {
     }
 
     public void getProfileAsync(OfflinePlayer p, IAsyncReadCallback<PlayerProfile> callback) {
-        scheduleReadTask(() -> invokeCallback(callback, getProfile(p)));
+        scheduleReadTask(() -> {
+            try {
+                invokeCallback(callback, getProfile(p));
+            } catch (Exception e) {
+                // Không để lỗi rơi im lặng: ghi log và cho phép callback xử lý như không tìm thấy hồ sơ
+                logger.log(
+                        Level.SEVERE,
+                        "Không thể tải hồ sơ của người chơi \"" + p.getName() + "\" (" + p.getUniqueId() + ")",
+                        e);
+                invokeCallback(callback, null);
+            }
+        });
     }
 
     public CompletableFuture<PlayerBackpack> getBackpackAsync(OfflinePlayer owner, int num) {
diff --git a/src/main/java/io/github/thebusybiscuit/slimefun4/api/player/PlayerProfile.java b/src/main/java/io/github/thebusybiscuit/slimefun4/api/player/PlayerProfile.java
